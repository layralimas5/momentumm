# Sem essas duas variáveis o app roda em MODO DEMO (dados em memória no navegador).
# Copie para .env.local e preencha com o projeto do Supabase.
# NUNCA commitar o .env.local. A anon key é pública por natureza, mas a service
# role key não entra no front em hipótese alguma.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Atalho de desenvolvimento: pula a tela de login e abre o app com dados demo.
# Só funciona em `npm run dev`; em build de produção é ignorado.
VITE_AUTH_BYPASS=false
